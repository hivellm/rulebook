{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "WebFetch(*)",
      "WebSearch",
      "TodoWrite",
      "mcp__rulebook",
      "mcp__cortex",
      "Bash(git -C e:/HiveLLM/Rulebook status --short)",
      "Bash(git -C e:/HiveLLM/Rulebook branch -a)",
      "Bash(git -C e:/HiveLLM/Rulebook tag --sort=-v:refname)",
      "Bash(node -e \"const p=require\\('./package.json'\\);console.log\\(p.name, p.version\\)\")",
      "Bash(node -e \"const s=require\\('./package.json'\\).scripts;console.log\\(JSON.stringify\\(s,null,1\\)\\)\")",
      "Bash(node dist/index.js update --dry-run --yes)",
      "Bash(node -e ' *)",
      "Bash(rm -f /tmp/probe.mts; cd e:/HiveLLM/Rulebook && npx vitest run tests/config-manager.test.ts tests/gitignore-rulebook-block.test.ts 2>&1 | grep -E \"×|✓ tests|Tests |Test Files\" | head -20)",
      "Bash(echo \"coverage exit code: $?\")",
      "Bash(cp .gitignore /tmp/gi-1)",
      "Bash(rm -f /tmp/gi-1)",
      "Bash(sed 's/^[^\\\\t]*\\\\t[^\\\\t]*\\\\t//')",
      "Bash(codespell --skip=\"*.lock,*.json,*.map,*.yaml,*.yml,*.csv,*.bib,target,node_modules,.git,dist,venv,build,benchmarks,coverage,templates\" --ignore-words-list=\"crate,ser,deser,upToDate,optIn,shouldBe,Bloc,thirdparty\")",
      "Bash(gh pr *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(crontab *)",
      "Bash(at *)",
      "Bash(batch *)",
      "Bash(systemctl *.timer*)",
      "Bash(systemd-run *--on-*)",
      "Bash(launchctl load *)",
      "Bash(launchctl bootstrap *)",
      "Bash(launchctl enable *)",
      "Bash(launchctl submit *)",
      "Bash(launchctl kickstart *)",
      "Bash(schtasks *)",
      "PowerShell(schtasks *)",
      "PowerShell(Register-ScheduledTask *)",
      "PowerShell(New-ScheduledTask *)",
      "PowerShell(Set-ScheduledTask *)",
      "PowerShell(Enable-ScheduledTask *)",
      "PowerShell(Register-ScheduledJob *)",
      "Edit(//etc/crontab)",
      "Edit(//etc/cron*/**)",
      "Edit(//etc/anacrontab)",
      "Edit(//var/spool/cron/**)",
      "Edit(//**/LaunchAgents/*.plist)",
      "Edit(//**/LaunchDaemons/*.plist)",
      "Edit(//etc/systemd/**/*.timer)",
      "Edit(//usr/lib/systemd/**/*.timer)",
      "Edit(~/.config/systemd/user/*.timer)"
    ]
  },
  "enabledMcpjsonServers": [
    "rulebook"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/.rulebook/tasks/**)",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/protect-task-scaffolding.sh"
          },
          {
            "type": "command",
            "if": "Write(**/.rulebook/tasks/**)",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/protect-task-scaffolding.sh"
          }
        ]
      }
    ]
  }
}
